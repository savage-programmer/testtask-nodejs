# Copy to .env and fill in. .env is gitignored and loaded by `npm start` / `npm run dev`.
PORT=3000

# AI provider: claude | gemini | openrouter | ollama | mock | rules
# Unset = claude if ANTHROPIC_API_KEY is present, else rules (offline).
AI_PROVIDER=
# Optional model override for the chosen provider. Defaults:
#   claude     claude-opus-5-5
#   gemini     gemini-3.5-flash-lite
#   openrouter nvidia/nemotron-3.5-super-vl:free   (free models rotate: https://openrouter.ai/collections/free-models)
#   ollama     llama3.2
AI_MODEL=
# AI call timeout in ms (default 5000); on expiry the rule-based fallback answers.
AI_TIMEOUT_MS=5000

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Rate limits (fixed 60s window)
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_USER_PER_MIN=20
